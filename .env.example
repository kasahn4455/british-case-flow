# Public Supabase project details used by the cookie-backed staff auth client.
# These values are designed to be exposed to the browser and are protected by RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only key used only by the authoritative public intake backend.
# Never prefix this key with VITE_ and never commit a real value.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
