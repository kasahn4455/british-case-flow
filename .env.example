# Phase 2 server-only Supabase configuration.
# Use the current Supabase secret key (sb_secret_...), not a browser/publishable key.
# Never prefix these server secrets with VITE_ and never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Staff authentication uses browser-safe Supabase project values.
# These VITE_ values are intentionally exposed to the browser; RLS + server checks protect data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public intake abuse controls.
# The site key is browser-safe and is rendered by the public intake form.
# The Turnstile secret and abuse pepper are server-only.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA_replace_me
TURNSTILE_SECRET_KEY=0x4AAAAAAA_replace_me
TURNSTILE_EXPECTED_ACTION=intake-submit
# Optional: set when production should accept tokens only for one hostname.
TURNSTILE_EXPECTED_HOSTNAME=intake.example.com

# High-entropy HMAC key used to pseudonymise IP/session rate-limit identifiers.
# Never log or expose this value.
INTAKE_ABUSE_PEPPER=replace_with_at_least_32_random_characters

# Provider-neutral outbox worker.
# A scheduler calls /api/workers/outbox and /api/workers/maintenance with
# Authorization: Bearer <OUTBOX_WORKER_TOKEN>.
OUTBOX_WORKER_TOKEN=replace_with_at_least_32_random_characters
# The outbox worker forwards each claimed event to this trusted delivery processor.
# This can be an n8n webhook or another approved processor. It must deduplicate by
# the Idempotency-Key header because retries are expected.
OUTBOX_DELIVERY_WEBHOOK_URL=https://automation.example.com/webhook/intake-outbox
OUTBOX_DELIVERY_WEBHOOK_TOKEN=replace_with_at_least_20_random_characters
